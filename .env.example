# ─── Takus 2.0 Environment Variables ───────────────────────────────────────
# Copy to .env.local for local development. Never commit .env.local.
# In Netlify: add these via Site settings → Environment variables.

# ─── AI Providers ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ─── Supabase ───────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Service key — server-side only (Netlify Functions), never expose to browser
SUPABASE_SERVICE_KEY=eyJ...

# ─── Netlify Blobs ──────────────────────────────────────────────────────────
# Automatically injected by Netlify at build/function runtime.
# No manual configuration required for production.
# For local dev: install Netlify CLI and run `netlify dev`.
# NETLIFY_BLOBS_CONTEXT is injected automatically.

# ─── Integrations (server-side only) ────────────────────────────────────────
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_USER_EMAIL=bot@yourcompany.com
JIRA_API_TOKEN=...
JIRA_PROJECT_KEY=PROJ

SLACK_BOT_TOKEN=xoxb-...

# GitHub OAuth app credentials (Phase 6)
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# Notion integration secret (Phase 6)
NOTION_OAUTH_CLIENT_ID=...
NOTION_OAUTH_CLIENT_SECRET=...
