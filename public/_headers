# Netlify security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), picture-in-picture=(self)
  X-DNS-Prefetch-Control: on
  # CSP — 'unsafe-inline' in style-src is required because components inject inline
  # styles for dynamic layouts. script-src is strict (no inline scripts in index.html).
  # The JSON-LD structured data block is exempt from script-src per the spec.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com https://alcdn.msauth.net https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' blob: data: https://*.googleusercontent.com https://graph.microsoft.com; media-src 'self' blob:; connect-src 'self' https://*.googleapis.com https://docs.googleapis.com https://graph.microsoft.com https://api.openai.com https://unpkg.com https://raw.githubusercontent.com https://cdn.jsdelivr.net https://accounts.google.com https://login.microsoftonline.com https://login.live.com https://hooks.slack.com https://api.github.com https://api.linear.app; worker-src 'self' blob:; frame-src https://content.googleapis.com https://accounts.google.com https://login.microsoftonline.com https://login.live.com; object-src 'none'; base-uri 'self'

# Long cache for hashed assets (vite adds content hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
